<?xml version="1.0" encoding="utf-8"?>
<!--
  API keys must never travel in cleartext. Remote providers therefore require
  HTTPS; plain HTTP is permitted only for an Ollama/LiteLLM instance running on
  the device itself or reachable through the Android emulator loopback host.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
