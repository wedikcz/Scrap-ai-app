# GEMINI_API_KEY — OPTIONAL build-time Gemini key.
#
# The recommended way to enable full AI is inside the app:
#   Nastavení AI (top bar gear) -> provider -> paste key -> Uložit -> Otestovat.
# The key is sealed with Android Keystore AES-256-GCM and never leaves the device.
#
# This value is compiled into BuildConfig and therefore extractable from the APK.
# Use it only for private development builds, never for a public release.
# CI does not need it: unit tests and lint run without any key.
GEMINI_API_KEY=MY_GEMINI_API_KEY
